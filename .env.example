# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed -- config/settings.py reads these via
# python-decouple and will fail loudly at startup if any are missing.

# Django's cryptographic signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# PostgreSQL connection for the flowise_questionnaire_db database.
DB_PASSWORD=
DB_HOST=
